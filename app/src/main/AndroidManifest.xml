<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the Classes content layer (PRD P0-6, T9/T10): fetching per-channel
         YouTube RSS feeds and loading thumbnails via Coil both need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLE heart-rate strap pairing/connection (PRD P1-4, T17). Two permission sets, split by
         API level (see core/heartrate/BlePermissions.kt):

         - API 29..30 (this project's actual target hardware, the Bike Gen 2 tablet on Android
           10 or 11): BLUETOOTH/BLUETOOTH_ADMIN are install-time "normal" permissions here (never
           requested at runtime); ACCESS_FINE_LOCATION is the runtime permission BLE scanning
           needs on these levels. maxSdkVersion="30" keeps them out of the merged manifest on
           API 31+, where they're superseded by the two permissions below.
         - API 31+ (Android 12+): BLUETOOTH_SCAN/BLUETOOTH_CONNECT are the dedicated runtime
           BLE permissions. `neverForLocation` on the scan permission is accurate here — this
           app only scans for the Heart Rate Service UUID, never derives location from scan
           results — and lets a user on 12+ grant it without also granting location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- CoarseFineLocation is suppressed because the check does not apply here: it warns that
         Android 12+ requires COARSE alongside FINE, but maxSdkVersion="30" already keeps FINE
         out of the merged manifest on 31+, where BLUETOOTH_SCAN with neverForLocation is used
         instead. Adding COARSE would request a permission this app never uses. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"
        tools:ignore="CoarseFineLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Opt-in in-app self-updater (PRD #22, T22): lets OpenRide hand a downloaded APK to the
         system package installer, so updating the bike's tablet doesn't mean re-running ADB.
         This only permits *asking*: the platform installer still shows its own confirmation, and
         the user must additionally allow "install unknown apps" for OpenRide in Settings. Nothing
         is fetched or installed unless a manifest URL has been configured and the user taps
         through — there is no baked-in update endpoint. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Mini-games head tracking (#33): CameraX analyses the rider-facing camera in memory to
         read head lean and standing (MediaPipe face detection, on device, with its usage
         reporting disabled below). Frames are never stored or sent, and the camera only runs
         while a camera game is on screen. The runtime request (with an explainer) belongs to the
         games hub. Not required: the app installs and runs without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Profile avatar photos are taken by handing ACTION_IMAGE_CAPTURE to whatever camera app
         the tablet has. Because the manifest now declares CAMERA (above), Android refuses that
         intent until the permission is granted, so the profile editor asks for it first. On API
         30+, package visibility filtering hides the camera app unless the intent is declared
         here — without this the launch just fails as "no camera app available". -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".OpenRideApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenRide"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.OpenRide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mini-games (#32): hosts the embedded Godot engine for game sessions. Landscape and
             the configChanges Godot needs so the engine's surface is never torn down by a
             config change; not exported, only the app itself starts it.

             It lives as long as the process (destroying it ends the engine, and Godot then
             kills the process), so it runs in its own task that leaving games moves to the
             back; singleTask brings that one instance forward on the next entry.

             Deliberately NOT excludeFromRecents: on the bike, an excluded task sitting in the
             background was removed by the system (when Peloton's software brought up its own
             activity at the display timeout), which destroyed the engine and the process.
             See GameHostActivity and docs/GAMES.md. -->
        <activity
            android:name=".games.GameHostActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.games"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|layoutDirection|locale"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Mini-games head tracker (#33): MediaPipe Tasks' tasks-core reports usage statistics to
             Google (TasksStatsProtoLogger → RemoteLoggingClient → datatransport's "cct" backend,
             log source COREML_ON_DEVICE_SOLUTIONS: app id and version, task, running mode,
             invocation counts and latencies; never images). The library has no switch for it,
             so this unregisters the cct backend: datatransport then drops each event before
             storing it ("Transport backend 'cct' is not registered"), and its uploader deletes
             any batch already queued for cct without sending it. Nothing else in the app uses
             datatransport. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- Backs ExportShare.kt (PRD P1-1/P1-2, T14): hands exported TCX/CSV files to the
             Android share sheet via a content:// URI instead of a raw file:// path. Also the
             self-updater's APK hand-off and avatar captures (see res/xml/file_paths.xml).

             An app-owned subclass at its own authority: the Godot AAR declares the plain
             androidx FileProvider at ${applicationId}.fileprovider with its own paths file,
             and the two must coexist (see OpenRideFileProvider). -->
        <provider
            android:name=".core.files.OpenRideFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Opt-in HOME launcher alias for MainActivity (PRD P0-8, T12). Disabled by default
          (android:enabled="false") so simply installing the app never hijacks the tablet's
          home screen — the rider opts in explicitly via:

              adb shell pm enable dev.digitalducktape.openride/.HomeLauncherAlias

          documented in docs/INSTALL.md, which also covers reverting it. Since MainActivity's
          own nav graph always starts at profile-select (see OpenRideNavHost), being launched
          as HOME already lands on profile-select with no separate boot-time logic needed —
          this alias just makes Android *offer* MainActivity as a home-screen replacement.

          A separate <activity-alias>, not a second intent-filter directly on MainActivity,
          so the HOME/DEFAULT categories can be toggled independently of the app's normal
          launcher icon (which stays enabled unconditionally).
        -->
        <activity-alias
            android:name=".HomeLauncherAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
